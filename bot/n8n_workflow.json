{
  "name": "X Account Bot — Weekly Pipeline",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 6 * * 1"
            }
          ]
        }
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000001",
      "name": "Every Monday 6 AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.BOT_BASE_URL }}/health",
        "options": {
          "timeout": 10000
        }
      },
      "id": "a1b2c3d4-0002-0002-0002-000000000002",
      "name": "Health Check",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-001",
              "leftValue": "={{ $json.status }}",
              "rightValue": "ok",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "a1b2c3d4-0003-0003-0003-000000000003",
      "name": "Bot Online?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BOT_BASE_URL }}/run",
        "options": {
          "timeout": 600000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "a1b2c3d4-0004-0004-0004-000000000004",
      "name": "Run Bot Pipeline",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 220]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-002",
              "leftValue": "={{ $json.status }}",
              "rightValue": "success",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "a1b2c3d4-0005-0005-0005-000000000005",
      "name": "Pipeline Succeeded?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1120, 220]
    },
    {
      "parameters": {
        "sendTo": "={{ $env.EMAIL_TO }}",
        "subject": "={{ '[X Bot] Week ' + $json.week + ' content ready — tap to approve' }}",
        "emailType": "html",
        "message": "={{ '<html><body style=\"font-family:sans-serif;max-width:640px;margin:0 auto;padding:20px\"><div style=\"border-left:4px solid #1DA1F2;padding-left:16px;margin-bottom:24px\"><h2 style=\"margin:0;color:#1DA1F2\">Week ' + $json.week + ' Content Ready</h2><p style=\"margin:4px 0 0;color:#888\">Generated by X Account Bot</p></div><p>Your weekly tweet batch is ready. Click the button below to approve and auto-schedule to Buffer.</p><h3>Preview</h3><pre style=\"background:#f5f5f5;padding:16px;border-radius:6px;font-size:13px;white-space:pre-wrap\">' + $json.tweet_preview.substring(0, 1000) + '...</pre><div style=\"text-align:center;margin:32px 0\"><a href=\"' + $json.approval_url + '\" style=\"display:inline-block;background:#1DA1F2;color:white;padding:16px 32px;border-radius:8px;text-decoration:none;font-size:16px;font-weight:bold\">Approve &amp; Schedule All Tweets →</a></div><p style=\"color:#888;font-size:13px\">This will schedule 5 standalone tweets + 2 threads to Buffer for next week.</p></body></html>' }}",
        "options": {}
      },
      "id": "a1b2c3d4-0006-0006-0006-000000000006",
      "name": "Send Approval Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [1340, 140],
      "credentials": {
        "gmailOAuth2": {
          "id": "gmail-cred-001",
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "sendTo": "={{ $env.EMAIL_TO }}",
        "subject": "[X Bot] ERROR — Pipeline failed this week",
        "emailType": "html",
        "message": "<html><body style=\"font-family:sans-serif;padding:20px\"><h2 style=\"color:#c62828\">Pipeline Failed</h2><p>The X Account Bot pipeline failed to run this week.</p><p><strong>Check:</strong></p><ul><li>Is the bot server running? (<code>uvicorn api:app</code>)</li><li>Is ANTHROPIC_API_KEY set?</li><li>Are Nitter instances reachable?</li></ul><p>Run manually: <code>python main.py</code></p></body></html>",
        "options": {}
      },
      "id": "a1b2c3d4-0007-0007-0007-000000000007",
      "name": "Send Error Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [1340, 300],
      "credentials": {
        "gmailOAuth2": {
          "id": "gmail-cred-001",
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "sendTo": "={{ $env.EMAIL_TO }}",
        "subject": "[X Bot] Bot is offline — start it before Monday",
        "emailType": "html",
        "message": "<html><body style=\"font-family:sans-serif;padding:20px\"><h2 style=\"color:#e65100\">Bot Offline</h2><p>The X Account Bot server is not responding. The weekly pipeline did not run.</p><p>Start the bot server:</p><pre style=\"background:#f5f5f5;padding:12px\">cd ~/Desktop/X-bot/bot\nsource venv/bin/activate\nuvicorn api:app --host 0.0.0.0 --port 8000</pre></body></html>",
        "options": {}
      },
      "id": "a1b2c3d4-0008-0008-0008-000000000008",
      "name": "Send Offline Alert",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [900, 400],
      "credentials": {
        "gmailOAuth2": {
          "id": "gmail-cred-001",
          "name": "Gmail account"
        }
      }
    }
  ],
  "connections": {
    "Every Monday 6 AM": {
      "main": [
        [
          {
            "node": "Health Check",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Health Check": {
      "main": [
        [
          {
            "node": "Bot Online?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Bot Online?": {
      "main": [
        [
          {
            "node": "Run Bot Pipeline",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Send Offline Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run Bot Pipeline": {
      "main": [
        [
          {
            "node": "Pipeline Succeeded?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Pipeline Succeeded?": {
      "main": [
        [
          {
            "node": "Send Approval Email",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Send Error Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner"
  },
  "staticData": null,
  "tags": ["x-bot", "automation"],
  "pinData": {},
  "versionId": "v1.0.0",
  "meta": {
    "templateCredsSetupCompleted": false,
    "instanceId": "x-account-bot"
  }
}
