# Copy this file to .env and fill in your values
# cp .env.example .env

# ── Required ──────────────────────────────────────────────────────────────────

# Claude API key — get from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Buffer API — get from buffer.com/developers/apps
# After creating an app, use the Access Token shown on the app page
BUFFER_ACCESS_TOKEN=
# Your X profile ID in Buffer — found at: https://api.bufferapp.com/1/profiles.json?access_token=YOUR_TOKEN
BUFFER_PROFILE_ID=

# The public URL where your bot server is accessible
# Local dev with ngrok:  https://abc123.ngrok.io
# Production server:     https://yourdomain.com
BOT_BASE_URL=http://localhost:8000

# ── Email (Gmail) ─────────────────────────────────────────────────────────────

# Your Gmail address (the one that sends approval emails)
EMAIL_FROM=you@gmail.com
# Gmail App Password — NOT your login password
# Get it at: myaccount.google.com/apppasswords
EMAIL_APP_PASSWORD=
# Where to send approval emails (can be same as EMAIL_FROM)
EMAIL_TO=you@gmail.com

# ── n8n (only needed for Docker Compose) ─────────────────────────────────────

N8N_USER=admin
N8N_PASSWORD=changeme_to_something_strong
